# ---------------------------------------------------------------------------
# WorshipJesusChrist — environment variables
# Copy this file to `.env.local` for development. On Vercel, set the same
# variables in Project Settings → Environment Variables.
# ---------------------------------------------------------------------------

# --- Database ---------------------------------------------------------------
# Where the SQLite database file lives.
#   Local default (recommended): ./data/app.db
#   On Vercel:                   /tmp/worshipjesuschrist.db
# See the README section "SQLite on Vercel" for the persistence trade-off.
DATABASE_PATH=./data/app.db

# --- Auth.js / NextAuth -----------------------------------------------------
# Secret used to sign JWTs and cookies. Generate one with:
#   npx auth secret     # or: openssl rand -base64 32
AUTH_SECRET=replace-me-with-a-long-random-string

# Public base URL of the deployment (no trailing slash).
#   Local:   http://localhost:3000
#   Vercel:  https://your-project.vercel.app (or your custom domain)
AUTH_URL=http://localhost:3000

# --- Default admin account (email + password sign-in) -----------------------
# CHANGE THESE IMMEDIATELY — the defaults below are public knowledge!
# The account is created automatically on first boot (or `npm run db:seed`).
# To rotate the password later:
#   npm run db:create-user -- admin@example.com '<new-strong-password>' admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123

# --- Unsplash ---------------------------------------------------------------
# Unsplash API access key (https://unsplash.com/developers → your app).
# Without it the app still works and falls back to the built-in gradient
# backgrounds, with attribution UI hidden.
UNSPLASH_ACCESS_KEY=replace-me

# How long (seconds) Unsplash search results are cached in memory.
# Default: 1800 (30 minutes).
UNSPLASH_CACHE_TTL_SECONDS=1800
